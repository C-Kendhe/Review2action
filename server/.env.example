# Server Configuration
PORT=5000

# AMD Token Factory OpenAI-Compatible LLM Configuration (Optional)
# Set USE_AMD_LLM=true to enable AMD Token Factory LLM inference.
# When set to false (or omitted), the app uses the built-in local heuristic engine.
USE_AMD_LLM=false
AMD_LLM_ENDPOINT=https://api.tokenfactory.amd.com/v1
AMD_LLM_MODEL=Qwen3.8-Flash-Next
AMD_LLM_API_KEY=
